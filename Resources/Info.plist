<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>DNSCryptGUI</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <!--
        Tells the system which AppIcon set in Assets.xcassets to use for
        the Dock/Finder/Spotlight/About-panel icon. Must match the folder
        name under Assets.xcassets minus the .appiconset suffix:
            AppIcon.appiconset → "AppIcon"
        This is the modern (Asset Catalog) replacement for CFBundleIconFile.
    -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>com.hlincore.DNSCryptGUI</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>DNSCryptGUI</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Menu-bar-only app. Remove this key if you want a Dock icon too. -->
    <key>LSUIElement</key>
    <true/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <true/>
    <key>NSSupportsSuddenTermination</key>
    <true/>
    <!--
        SMPrivilegedExecutables maps the helper's bundle identifier to the
        code signing designated requirement that the GUI trusts. This is
        what lets SMAppService install the helper out of our bundle.

        Strict shipping form: the helper binary must be signed by Apple,
        identify as `com.hlincore.DNSCryptGUI.Helper`, carry either a
        Mac App Store leaf cert (OID 1.2.840.113635.100.6.1.9) or a
        Developer ID intermediate (OID 1.2.840.113635.100.6.2.6), and
        have our Team ID as the leaf's organisational unit.
    -->
    <key>SMPrivilegedExecutables</key>
    <dict>
        <key>com.hlincore.DNSCryptGUI.Helper</key>
        <string>anchor apple generic and identifier "com.hlincore.DNSCryptGUI.Helper" and (certificate leaf[field.1.2.840.113635.100.6.1.9] or certificate 1[field.1.2.840.113635.100.6.2.6]) and certificate leaf[subject.OU] = "$(DEVELOPMENT_TEAM)"</string>
    </dict>
</dict>
</plist>
