<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      This app cannot be sandboxed: it shells out to brew, networksetup,
      osascript, and reads/writes /opt/homebrew/etc. Leave App Sandbox OFF
      in the Xcode target and keep this file as the Code Sign entitlements.
    -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Required for the AppleScript privilege-elevation flow. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
