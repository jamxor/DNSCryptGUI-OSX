<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.hlincore.DNSCryptGUI.Helper</string>
    <key>CFBundleName</key>
    <string>DNSCryptGUIHelper</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundleExecutable</key>
    <string>DNSCryptGUIHelper</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <!--
        SMAuthorizedClients lists the designated requirements of clients
        that are allowed to XPC into this helper. The client must pass
        the requirement string for the connection to be accepted.

        Strict shipping form: the connecting binary must be signed by
        Apple, identify as `com.hlincore.DNSCryptGUI`, carry either a
        Mac App Store leaf cert (OID 1.2.840.113635.100.6.1.9) or a
        Developer ID intermediate (OID 1.2.840.113635.100.6.2.6), and
        have our Team ID as the leaf's organisational unit.

        For local development (Apple Development cert), this requirement
        will fail. Either re-sign your debug builds with Developer ID,
        or temporarily add a permissive entry while iterating — but
        REMOVE it again before tagging a release.
    -->
    <key>SMAuthorizedClients</key>
    <array>
        <string>anchor apple generic and identifier "com.hlincore.DNSCryptGUI" and (certificate leaf[field.1.2.840.113635.100.6.1.9] or certificate 1[field.1.2.840.113635.100.6.2.6]) and certificate leaf[subject.OU] = "$(DEVELOPMENT_TEAM)"</string>
    </array>
</dict>
</plist>
